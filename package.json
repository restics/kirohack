{
  "name": "economic-cascade-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src server tests --max-warnings 0",
    "lint:fix": "eslint src server tests --fix",
    "test": "vitest --run",
    "test:api": "vitest --run --config vitest.api.config.ts",
    "test:all": "vitest --run && vitest --run --config vitest.api.config.ts",
    "server": "node node_modules/tsx/dist/cli.mjs server/index.ts",
    "server:dev": "node node_modules/tsx/dist/cli.mjs watch server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "fast-check": "^4.7.0",
    "openai": "^4.104.0",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
